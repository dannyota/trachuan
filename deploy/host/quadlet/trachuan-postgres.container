[Unit]
Description=trachuan PostgreSQL 18 and pgvector
RequiresMountsFor=/srv/trachuan/data

[Container]
Image=@POSTGRES_IMAGE@
ContainerName=trachuan-postgres
Entrypoint=/usr/local/bin/pgbackrest-entrypoint.sh
Volume=/srv/trachuan/host/backup-job.sh:/usr/local/bin/backup-job.sh:ro,z
Network=host
User=999:999
DropCapability=ALL
NoNewPrivileges=true
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=postgres
Environment=POSTGRES_HOST_AUTH_METHOD=scram-sha-256
Environment="POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=scram-sha-256"
Environment=PGBACKREST_CONFIG_INCLUDE_PATH=/run/pgbackrest/conf.d
Environment=PGPASSFILE=/run/pgbackrest/pgpass
Mount=type=tmpfs,destination=/run/pgbackrest,tmpfs-mode=0700,U=true,noexec,nosuid,nodev
Secret=backup_s3_key,type=mount,uid=999,gid=999,mode=0400
Secret=backup_s3_key_secret,type=mount,uid=999,gid=999,mode=0400
Volume=/etc/pgbackrest/pgbackrest.conf:/etc/pgbackrest/pgbackrest.conf:ro,z
Volume=/srv/trachuan/data/pgbackrest:/srv/trachuan/data/pgbackrest:Z,U
Volume=/srv/trachuan/host/pgbackrest-entrypoint.sh:/usr/local/bin/pgbackrest-entrypoint.sh:ro,z
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
Secret=postgres_password,type=mount,uid=999,gid=999,mode=0400
Secret=auth_db_password,type=mount,uid=999,gid=999,mode=0400
Secret=corpus_reader_password,type=mount,uid=999,gid=999,mode=0400
Volume=/srv/trachuan/data/postgres:/var/lib/postgresql:Z,U
Volume=/srv/trachuan/host/bootstrap.sh:/docker-entrypoint-initdb.d/10-auth.sh:ro,z
Volume=/srv/trachuan/host/grant-corpus.sh:/usr/local/bin/grant-corpus.sh:ro,z
Volume=/srv/trachuan/host/wait-postgres.sh:/usr/local/bin/wait-postgres.sh:ro,z
Volume=/srv/trachuan/host/postgres-admin.sh:/usr/local/bin/postgres-admin.sh:ro,z
Volume=/srv/trachuan/host/repair-postgres-auth.sh:/usr/local/bin/repair-postgres-auth.sh:ro,z
Exec=postgres -c archive_mode=on -c "archive_command=pgbackrest --stanza=trachuan archive-push %%p" -c archive_timeout=300 -c listen_addresses=127.0.0.1 -c port=5432 -c shared_buffers=4GB -c effective_cache_size=16GB -c maintenance_work_mem=512MB -c max_parallel_maintenance_workers=1 -c max_connections=50 -c jit=off
PodmanArgs=--cpus=4 --memory=8g --memory-reservation=4500m --shm-size=3g
HealthCmd=/usr/local/bin/postgres-admin.sh pg_isready -h 127.0.0.1 -U postgres -d postgres
HealthInterval=10s
HealthTimeout=3s
HealthRetries=3
HealthStartPeriod=120s
HealthOnFailure=kill
LogDriver=journald

[Service]
ExecStartPre=/usr/bin/mountpoint -q /srv/trachuan/data
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
LimitCORE=0

[Install]
WantedBy=default.target
