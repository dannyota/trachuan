/var/log/trachuan/deploy.log /var/log/trachuan/release.log /var/log/trachuan/release-frameworks.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
}
/var/log/trachuan/backup.log /var/log/trachuan/watch/watch.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
