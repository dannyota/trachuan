[Unit]
Description=trachuan backup restore-check
Requires=trachuan-postgres.service
After=trachuan-postgres.service
RequiresMountsFor=/srv/trachuan/data

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/trachuan/host/backup.py restore-check
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=1200
TimeoutStopSec=30
KillMode=mixed
UMask=0077
LimitCORE=0
