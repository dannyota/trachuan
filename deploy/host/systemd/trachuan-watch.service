[Unit]
Description=Watch host health and send Telegram alerts

[Service]
Type=oneshot
User=trachuan-watch
ExecStart=/usr/bin/python3 -I /usr/local/libexec/trachuan/watch.py
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/trachuan/state/watch /var/log/trachuan/watch
LimitCORE=0
MemorySwapMax=0
TimeoutStartSec=45
TimeoutStopSec=5
MemoryMax=128M
